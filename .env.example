# Variables d'environnement d'Allée Nette.
#
# En local : copiez ce fichier en .env.local et remplissez les valeurs.
# .env.local n'est jamais versionné ; ne mettez aucun secret dans ce fichier-ci.
#
# Sur Netlify : Configuration du projet > Environment variables.
# Portée Builds + Functions, puis redéployer après modification
# (les fonctions ne voient pas les variables écrites dans netlify.toml).
# Ne préfixez jamais un secret par NEXT_PUBLIC_ : il serait envoyé aux navigateurs.

# URL publique du site, sans barre finale, par exemple https://www.allee-nette.fr
NEXT_PUBLIC_SITE_URL=

# --- Réservation : e-mails (Resend) ----------------------------------------

# Clé d'API Resend (secrète), lue par le serveur au moment de l'envoi.
# Sans clé hors production : mode démonstration, aucun e-mail n'est envoyé
# et la demande est acceptée. Sans clé en production : le formulaire invite
# à appeler ou à écrire sur WhatsApp.
RESEND_API_KEY=

# Expéditeur des e-mails, sur un domaine vérifié chez Resend,
# par exemple : Allée Nette <reservation@votre-domaine.fr>
# Les destinataires sont les e-mails des associés, dans src/config/site.ts.
RESERVATION_EXPEDITEUR=

# --- Réservation : anti-spam -------------------------------------------------

# Hors production uniquement (local, aperçus) : nombre de demandes acceptées
# par adresse IP et par 10 minutes. Vide : 5, comme en production.
# Les tests de bout en bout la relèvent (playwright.config.ts).
# En production, la limite reste toujours de 5 par 10 minutes.
RESERVATION_LIMITE_DEBIT=

# --- Paiement en ligne : liens signés -----------------------------------------

# Secret qui signe les liens de paiement (HMAC-SHA256), 32 caractères au moins.
# Serveur uniquement. Générez-en un, différent pour la production et les aperçus :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Le changer invalide tous les liens déjà envoyés (valables 7 jours).
# Sans secret : la page /paiement refuse les liens et l'administration
# ne peut pas en générer.
PAYMENT_LINK_SECRET=

# --- Paiement en ligne : Stripe Checkout (un compte par associé) --------------

# Clé de l'API Stripe de chaque encaisseur : A pour l'associé A, B pour
# l'associé B (noms et SIREN dans src/config/site.ts). Serveur uniquement.
# Où la trouver : tableau de bord Stripe du compte concerné > Développeurs >
# Clés API. Préférez une clé restreinte (« rk_test_... » en mode test, puis
# « rk_live_... » en mode réel) avec le minimum de droits : Checkout Sessions
# en écriture, PaymentIntents et Charges en lecture (détail dans docs/paiement.md).
# Une clé secrète « sk_test_... » / « sk_live_... » fonctionne aussi.
# Sans clé : la page /paiement affiche « Paiement en ligne bientôt disponible ».
# Clé de test : bandeau « Mode test : aucun débit réel ».
# Clé réelle hors production (aperçus Netlify, local) : refusée.
# Ne collez jamais une vraie clé dans ce fichier ni dans le code : un test
# (tests/unit/fuite-cles.test.ts) bloque toute clé trouvée dans le dépôt.
STRIPE_API_KEY_A=
STRIPE_API_KEY_B=

# Clé de signature du webhook de chaque compte Stripe (« whsec_... »).
# Serveur uniquement. Les webhooks sont OBLIGATOIRES : c'est par eux que
# l'associé reçoit l'e-mail « Paiement reçu ». Dans le tableau de bord du
# compte A : Développeurs > Webhooks > Ajouter une destination, adresse
#   https://<votre-domaine>/api/stripe/webhook/A
# (B pour l'associé B), événements checkout.session.completed,
# checkout.session.async_payment_succeeded et
# checkout.session.async_payment_failed. Puis copiez la clé de signature ici.
# Une clé différente en mode test et en mode réel. Sans clé : les événements
# sont refusés (503) et Stripe réessaie pendant plusieurs jours.
STRIPE_WEBHOOK_SECRET_A=
STRIPE_WEBHOOK_SECRET_B=

# --- Paiement en ligne : PayPal en secours (un compte par associé) -----------

# « true » pour afficher le bouton « Payer avec PayPal » sous le paiement par
# carte. À activer seulement si PayPal n'est pas activable dans Stripe
# (docs/paiement.md). Toute autre valeur, ou vide : aucun bouton PayPal.
PAYPAL_ENABLED=

# « sandbox » (bac à sable de test, par défaut) ou « live » (paiements réels).
# « live » est refusé hors production (aperçus Netlify, local).
PAYPAL_ENV=

# Identifiants d'application REST de chaque encaisseur.
# Où les trouver : https://developer.paypal.com > Apps & Credentials, avec le
# compte PayPal Business de l'associé (onglet Sandbox pour les tests, Live
# pour le réel). L'identifiant (Client ID) est public : il est transmis au
# navigateur pour charger le module PayPal, après un clic du client.
# Le secret (Secret) reste sur le serveur. Sans l'identifiant ET le secret
# d'un encaisseur, son bouton PayPal n'apparaît pas.
PAYPAL_CLIENT_ID_A=
PAYPAL_CLIENT_SECRET_A=
PAYPAL_CLIENT_ID_B=
PAYPAL_CLIENT_SECRET_B=

# --- Administration (/admin/lien-paiement) ---------------------------------------

# Mot de passe de la page d'administration (authentification du navigateur :
# identifiant au choix, par exemple « admin », puis ce mot de passe).
# Serveur uniquement. Choisissez-le long et aléatoire, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sans valeur : l'administration répond « Administration non configurée » (503),
# elle ne s'ouvre jamais sans mot de passe.
# Sur Netlify, portée Builds + Functions : le contrôle a lieu dans une fonction edge.
ADMIN_PASSWORD=

# --- Référencement -------------------------------------------------------------

# Mettre « oui » le jour du lancement (portée Builds), puis redéployer.
# Tant que la valeur n'est pas « oui », le site en ligne reste en noindex
# et robots.txt interdit l'exploration.
INDEXATION=
